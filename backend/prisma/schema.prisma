generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum OnboardingRequestStatus {
  NEW
  WAITING_FOR_INFO
  UNDER_REVIEW
  READY_TO_CREATE
  ACTIVATED
  REJECTED
}

enum OnboardingOperationMode {
  PLATFORM_ONLY
  APP_AND_PLATFORM
}

enum PlatformRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum PermissionCategory {
  DASHBOARD
  TENANTS
  USERS
  INBOX
  CHANNELS
  WHATSAPP
  AUTOMATION
  NOTIFICATIONS
  REPORTS
  SYSTEM
}

enum ChannelType {
  WHATSAPP
  EMAIL
  WEBCHAT
  INSTAGRAM
  X
  SMS
}

enum ChannelStatus {
  CONNECTED
  PENDING
  DISCONNECTED
  FAILED
  NEEDS_REVIEW
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  PENDING_CUSTOMER
  PENDING_AGENT
  SLA_WARNING
  SLA_BREACHED
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  VIP
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
  AUTOMATION
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  TEMPLATE
  SYSTEM
  INTERNAL_NOTE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  NEW_MESSAGE
  CONVERSATION_ASSIGNED
  SLA_WARNING
  SLA_BREACHED
  CUSTOMER_REPLIED
  QUEUE_OVERLOADED
  AUTOMATION_TRIGGERED
  AGENT_MENTIONED
  WEBHOOK_ISSUE
  WHATSAPP_QUALITY_WARNING
}

enum NotificationPriority {
  INFO
  WARNING
  CRITICAL
}

enum WorkflowStatus {
  ACTIVE
  DISABLED
  FAILED
  TESTING
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentMeetingType {
  IN_PERSON
  PHONE
  ONLINE
}

enum MeetingProvider {
  ZOOM
  WEBEX
  TEAMS
  GOOGLE_MEET
  CUSTOM
}

enum MeetingStatus {
  NOT_CREATED
  LINK_ADDED
  SENT
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AutomationTriggerType {
  NEW_MESSAGE
  CONVERSATION_UNASSIGNED
  SLA_BREACHED
  APPOINTMENT_CREATED
  APPOINTMENT_DUE_SOON
  TICKET_CREATED
  TICKET_STATUS_CHANGED
}

enum AutomationLogStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logoUrl       String?        @map("logo_url")
  status        TenantStatus   @default(ACTIVE)
  plan          TenantPlan     @default(STARTER)
  subscriptionStart DateTime?  @map("subscription_start")
  subscriptionEnd   DateTime?  @map("subscription_end")
  maxUsers      Int            @default(10) @map("max_users")
  maxChannels   Int            @default(2) @map("max_channels")
  monthlyConversationLimit Int  @default(1000) @map("monthly_conversation_limit")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @map("created_by")
  updatedBy     String?        @map("updated_by")
  deletedAt     DateTime?      @map("deleted_at")
  users         User[]
  roles         Role[]
  channels      Channel[]
  customers     Customer[]
  queues        Queue[]
  conversations Conversation[]
  messages      Message[]
  notifications Notification[]
  workflows     Workflow[]
  quickReplies  QuickReply[]
  whatsappTemplates WhatsAppTemplate[]
  appointments  Appointment[]
  meetings      Meeting[]
  tickets       Ticket[]
  automationRules AutomationRule[]
  automationLogs  AutomationLog[]
  onboardingRequest OnboardingRequest?

  @@index([status])
  @@index([plan])
  @@index([subscriptionEnd])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("tenants")
}

model OnboardingRequest {
  id                     String                  @id @default(cuid())
  organizationName       String                  @map("organization_name")
  website                String?
  contactName            String                  @map("contact_name")
  contactEmail           String                  @map("contact_email")
  contactPhone           String                  @map("contact_phone")
  requestedPlan          TenantPlan              @map("requested_plan")
  requestedUsers         Int                     @default(5) @map("requested_users")
  requestedChannels      String[]                @default([]) @map("requested_channels")
  whatsappNumber         String?                 @map("whatsapp_number")
  hasMetaBusiness        Boolean                 @default(false) @map("has_meta_business")
  hasWhatsAppBusinessApp Boolean                 @default(false) @map("has_whatsapp_business_app")
  operationMode          OnboardingOperationMode @default(PLATFORM_ONLY) @map("operation_mode")
  status                 OnboardingRequestStatus @default(NEW)
  notes                  String?
  activatedTenantId      String?                 @unique @map("activated_tenant_id")
  activatedTenant        Tenant?                 @relation(fields: [activatedTenantId], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([requestedPlan])
  @@index([createdAt])
  @@map("onboarding_requests")
}

model User {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  name         String
  email        String
  passwordHash String         @map("password_hash")
  status       UserStatus     @default(ACTIVE)
  platformRole PlatformRole   @default(COMPANY_USER) @map("platform_role")
  avatar       String?
  roleId       String?        @map("role_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  createdBy    String?        @map("created_by")
  updatedBy    String?        @map("updated_by")
  deletedAt    DateTime?      @map("deleted_at")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assigned     Conversation[] @relation("ConversationAssignedUser")
  appointments Appointment[]  @relation("AppointmentAssignedUser")
  tickets      Ticket[]       @relation("TicketAssignedUser")
  notifications Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
  @@index([status])
  @@index([platformRole])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  deletedAt       DateTime?        @map("deleted_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String             @id @default(cuid())
  key             String             @unique
  category        PermissionCategory
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String?    @map("created_by")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Channel {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  type          ChannelType
  status        ChannelStatus @default(PENDING)
  name          String
  config        Json?
  externalId    String?       @map("external_id")
  connectedAt   DateTime?     @map("connected_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     String?       @map("created_by")
  updatedBy     String?       @map("updated_by")
  deletedAt     DateTime?     @map("deleted_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("channels")
}

model Customer {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  phone         String?
  email         String?
  tags          String[]       @default([])
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @map("created_by")
  updatedBy     String?        @map("updated_by")
  deletedAt     DateTime?      @map("deleted_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments Appointment[]
  meetings     Meeting[]
  tickets      Ticket[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("customers")
}

model QuickReply {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  title       String
  content     String
  category    String?
  channelType ChannelType? @map("channel_type")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, channelType])
  @@map("quick_replies")
}

model WhatsAppTemplate {
  id              String                 @id @default(cuid())
  tenantId        String                 @map("tenant_id")
  name            String
  language        String                 @default("ar")
  category        String
  status          WhatsAppTemplateStatus @default(DRAFT)
  body            String
  variables       String[]               @default([])
  channelType     ChannelType            @default(WHATSAPP) @map("channel_type")
  metaTemplateId  String?                @map("meta_template_id")
  rejectionReason String?                @map("rejection_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("whatsapp_templates")
}

model Queue {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  slaPolicy     Json?          @map("sla_policy")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @map("created_by")
  updatedBy     String?        @map("updated_by")
  deletedAt     DateTime?      @map("deleted_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("queues")
}

model Conversation {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  channelId      String               @map("channel_id")
  customerId     String               @map("customer_id")
  assignedUserId String?              @map("assigned_user_id")
  queueId        String?              @map("queue_id")
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  slaDeadline    DateTime?            @map("sla_deadline")
  slaWarnedAt     DateTime?            @map("sla_warned_at")
  slaBreachedAt   DateTime?            @map("sla_breached_at")
  lastMessageAt   DateTime?            @map("last_message_at")
  lastMessagePreview String?           @map("last_message_preview")
  unreadCount     Int                  @default(0) @map("unread_count")
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  createdBy      String?              @map("created_by")
  updatedBy      String?              @map("updated_by")
  deletedAt      DateTime?            @map("deleted_at")
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel        Channel              @relation(fields: [channelId], references: [id], onDelete: Restrict)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser   User?                @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  queue          Queue?               @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messages       Message[]
  notifications  Notification[]
  appointments   Appointment[]
  meetings       Meeting[]
  tickets        Ticket[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, queueId])
  @@index([assignedUserId])
  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, slaDeadline])
  @@index([tenantId, lastMessageAt])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Appointment {
  id             String                 @id @default(cuid())
  tenantId       String                 @map("tenant_id")
  customerId     String                 @map("customer_id")
  conversationId String?                @map("conversation_id")
  assignedUserId String?                @map("assigned_user_id")
  title          String
  description    String?
  startAt        DateTime               @map("start_at")
  endAt          DateTime               @map("end_at")
  status         AppointmentStatus      @default(SCHEDULED)
  meetingType    AppointmentMeetingType @default(PHONE) @map("meeting_type")
  meetingLink    String?                @map("meeting_link")
  location       String?
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation   Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser   User?                  @relation("AppointmentAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  meeting        Meeting?

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedUserId])
  @@index([deletedAt])
  @@map("appointments")
}

model Meeting {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  appointmentId  String          @unique @map("appointment_id")
  customerId     String          @map("customer_id")
  conversationId String?         @map("conversation_id")
  provider       MeetingProvider
  meetingLink    String          @map("meeting_link")
  meetingId      String?         @map("meeting_id")
  status         MeetingStatus   @default(LINK_ADDED)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, provider])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([deletedAt])
  @@map("meetings")
}

model Ticket {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  customerId     String?        @map("customer_id")
  conversationId String?        @map("conversation_id")
  assignedUserId String?        @map("assigned_user_id")
  title          String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  category       String?
  tags           String[]       @default([])
  dueAt          DateTime?      @map("due_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser   User?          @relation("TicketAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, dueAt])
  @@index([deletedAt])
  @@map("tickets")
}

model AutomationRule {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  name        String
  description String?
  triggerType AutomationTriggerType @map("trigger_type")
  conditions  Json?
  actions     Json
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs        AutomationLog[]

  @@index([tenantId])
  @@index([tenantId, triggerType])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@map("automation_rules")
}

model AutomationLog {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  ruleId      String?               @map("rule_id")
  triggerType AutomationTriggerType @map("trigger_type")
  targetType  String                @map("target_type")
  targetId    String                @map("target_id")
  status      AutomationLogStatus
  message     String?
  createdAt   DateTime              @default(now()) @map("created_at")
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule        AutomationRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, ruleId])
  @@index([tenantId, status])
  @@index([tenantId, triggerType])
  @@index([createdAt])
  @@map("automation_logs")
}

model Message {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  conversationId    String            @map("conversation_id")
  channelId         String            @map("channel_id")
  senderType        MessageSenderType @map("sender_type")
  senderId          String?           @map("sender_id")
  content           String
  messageType       MessageType       @default(TEXT) @map("message_type")
  status            MessageStatus     @default(PENDING)
  externalMessageId String?           @map("external_message_id")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  createdBy         String?           @map("created_by")
  updatedBy         String?           @map("updated_by")
  deletedAt         DateTime?         @map("deleted_at")
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel           Channel           @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([tenantId, externalMessageId])
  @@index([tenantId])
  @@index([conversationId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, senderId])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model Notification {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  userId         String?              @map("user_id")
  conversationId String?              @map("conversation_id")
  type           NotificationType
  priority       NotificationPriority @default(INFO)
  title          String
  body           String
  readAt         DateTime?            @map("read_at")
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  createdBy      String?              @map("created_by")
  updatedBy      String?              @map("updated_by")
  deletedAt      DateTime?            @map("deleted_at")
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, type])
  @@index([tenantId, priority])
  @@index([conversationId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model Workflow {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  name       String
  trigger    String
  conditions Json?
  actions    Json
  enabled    Boolean        @default(false)
  status     WorkflowStatus @default(TESTING)
  lastRunAt  DateTime?      @map("last_run_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  createdBy  String?        @map("created_by")
  updatedBy  String?        @map("updated_by")
  deletedAt  DateTime?      @map("deleted_at")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, enabled])
  @@index([tenantId, status])
  @@index([tenantId, trigger])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("workflows")
}
